rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function em() { return request.auth != null ? request.auth.token.email : ''; }
    // 한강숲(기존 데이터): 지점 폴더(centers)를 뺀 나머지 전부
    match /{coll}/{rest=**} {
      allow read, write: if coll != 'centers' && em() == 'supdc0301@hangangsup.app';
    }
    // 더숲 / 숲: 각자 지점 폴더 안에서만
    match /centers/{c}/{rest=**} {
      allow read, write: if (c == 'thesup' && em() == 'supdc0801@hangangsup.app')
                         || (c == 'sup'    && em() == 'supdc0420@hangangsup.app');
    }
  }
}
